                        "expr": "palserver_player_level",
                        "format": "time_series",
                        "instant": false,
                        "legendFormat": "__auto",
                        "range": true
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "ds-prometheus"
                      }
