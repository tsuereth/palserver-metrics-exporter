                    "refId": "level",
                    "hidden": true
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "__expr__",
                      "version": "v0",
                      "spec": {
                        "expression": "WITH last_online AS (\n  SELECT\n    MAX(time) AS time,\n    player_user_id\n  FROM\n    info\n  GROUP BY\n    player_user_id\n)\nSELECT\n  info.player_name AS Name,\n  level.__value__ AS Level,\n  info.player_user_id AS UserId,\n  info.player_ip AS IP,\n  last_online.time AS LastOnline\nFROM\n  info,\n  level,\n  last_online\nWHERE\n  (\n    info.time = last_online.time\n    AND info.player_user_id = last_online.player_user_id\n  )\n  AND (\n    level.time = last_online.time\n    AND level.player_user_id = last_online.player_user_id\n  )\nORDER BY\n  Name ASC",
                        "type": "sql"
                      },
                      "labels": {
                        "grafana.app/export-label": "__expr__-1",
                        "grafana.app/export-datasource-name": "Expression"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
